<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Fork of https://github.com/codelibs/elasticsearch-plugin-archetype
    Reworked for Elasticsearch 7.10.2, with a new "pluginType" parameter that
    generates any kind of Elasticsearch plugin (REST, analysis, ingest, ... or
    an arbitrary fully qualified plugin interface).
  -->
  <groupId>org.codelibs</groupId>
  <artifactId>elasticsearch-plugin-archetype</artifactId>
  <version>7.10.2</version>
  <packaging>maven-archetype</packaging>

  <name>Archetype for Elasticsearch 7.10.2 plugin</name>
  <description>Maven archetype that generates Elasticsearch 7.10.2 plugin projects of any plugin type.</description>
  <url>https://github.com/zg900213/elasticsearch-plugin-archetype</url>
  <inceptionYear>2012</inceptionYear>

  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/zg900213/elasticsearch-plugin-archetype.git</connection>
    <developerConnection>scm:git:https://github.com/zg900213/elasticsearch-plugin-archetype.git</developerConnection>
    <url>https://github.com/zg900213/elasticsearch-plugin-archetype</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <archetype.plugin.version>3.2.1</archetype.plugin.version>
  </properties>

  <build>
    <defaultGoal>install</defaultGoal>
    <extensions>
      <extension>
        <groupId>org.apache.maven.archetype</groupId>
        <artifactId>archetype-packaging</artifactId>
        <version>${archetype.plugin.version}</version>
      </extension>
    </extensions>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-archetype-plugin</artifactId>
          <version>${archetype.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-archetype-plugin</artifactId>
        <extensions>true</extensions>
      </plugin>
    </plugins>
  </build>
</project>
