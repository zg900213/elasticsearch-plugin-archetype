<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor name="elasticsearch-plugin-archetype"
  xmlns="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0 https://maven.apache.org/xsd/archetype-descriptor-1.1.0.xsd">
  <requiredProperties>
    <!-- Java class name prefix, e.g. Hello -> HelloPlugin / RestHelloAction -->
    <requiredProperty key="pluginName">
      <defaultValue>Hello</defaultValue>
    </requiredProperty>
    <!--
      Selects the Elasticsearch plugin interface to implement.
      Built-in aliases: rest (default), action, analysis, ingest, mapper,
      script, search, repository, discovery, engine, indexstore, systemindex,
      circuitbreaker, cluster, network, persistent, reloadable, extensible,
      basic. Any fully qualified interface name (containing a dot) is also
      accepted. See README.md for the full list.
    -->
    <requiredProperty key="pluginType">
      <defaultValue>rest</defaultValue>
    </requiredProperty>
    <!--
      NEW: which build tooling the generated project ships with.
      maven = pom.xml + assembly (classic Maven archetype output)
      gradle = build.gradle using elasticsearch.esplugin + elasticsearch.testclusters
      both (default) = generated project can be built with either tool
      META-INF/archetype-post-generate.groovy removes the unused files.
    -->
    <requiredProperty key="buildTool">
      <defaultValue>both</defaultValue>
    </requiredProperty>
    <requiredProperty key="elasticsearchVersion">
      <defaultValue>7.10.2</defaultValue>
    </requiredProperty>
    <requiredProperty key="restName">
      <defaultValue>hello</defaultValue>
    </requiredProperty>
  </requiredProperties>
  <fileSets>
    <!-- Root-level text files need an explicit fileSet (pom.xml is handled by the archetype plugin itself) -->
    <fileSet filtered="true" encoding="UTF-8">
      <directory></directory>
      <includes>
        <include>README.md</include>
        <include>build.gradle</include>
        <include>settings.gradle</include>
        <include>gradle.properties</include>
        <include>LICENSE.txt</include>
        <include>NOTICE.txt</include>
      </includes>
    </fileSet>
    <!-- Wrapper scripts contain shell $ variables: never run Velocity on them -->
    <fileSet filtered="false" encoding="UTF-8">
      <directory></directory>
      <includes>
        <include>gradlew</include>
        <include>gradlew.bat</include>
      </includes>
    </fileSet>
    <!-- Binary jar + properties: copy verbatim -->
    <fileSet filtered="false" encoding="UTF-8">
      <directory>gradle/wrapper</directory>
      <includes>
        <include>**/*</include>
      </includes>
    </fileSet>
    <fileSet filtered="true" packaged="true" encoding="UTF-8">
      <directory>src/main/java</directory>
      <includes>
        <include>**/*.java</include>
      </includes>
    </fileSet>
    <fileSet filtered="true" encoding="UTF-8">
      <directory>src/main/assemblies</directory>
      <includes>
        <include>**/*.xml</include>
      </includes>
    </fileSet>
    <!-- Maven descriptor template; esplugin generates its own descriptor, so keep a
         separate .tmpl file to avoid two plugin-descriptor.properties in the zip -->
    <fileSet filtered="true" encoding="UTF-8">
      <directory>src/main/plugin-metadata</directory>
      <includes>
        <include>**/*.tmpl</include>
      </includes>
    </fileSet>
    <fileSet filtered="true" packaged="true" encoding="UTF-8">
      <directory>src/test/java</directory>
      <includes>
        <include>**/*.java</include>
      </includes>
    </fileSet>
    <!-- Java REST tests executed by elasticsearch.testclusters -->
    <fileSet filtered="true" packaged="true" encoding="UTF-8">
      <directory>src/javaRestTest/java</directory>
      <includes>
        <include>**/*.java</include>
      </includes>
    </fileSet>
  </fileSets>
</archetype-descriptor>
